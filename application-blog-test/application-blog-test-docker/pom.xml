<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.xwiki.contrib.blog</groupId>
    <artifactId>application-blog-test</artifactId>
    <version>9.15.15-SNAPSHOT</version>
  </parent>
  <artifactId>application-blog-test-docker</artifactId>
  <name>Blog - Tests - Functional Docker Tests</name>
  <packaging>jar</packaging>
  <description>Docker-based functional tests for the Blog Application</description>
  <properties>
    <!-- Functional tests are allowed to output content to the console -->
    <xwiki.surefire.captureconsole.skip>true</xwiki.surefire.captureconsole.skip>
  </properties>
  <dependencyManagement>
    <dependencies>
      <!-- XWiki 14.10.x comes with Testcontainers 1.17.5, which is too old for recent Docker Engines (29+): it forces
           Docker API version 1.32 when none is configured, and its Ryuk (0.3.4) uses API version 1.29, both refused by
           a daemon whose minimum API version is 1.40+ ("client version 1.xx is too old"). Testcontainers 1.21.4
           negotiates the API version and uses a newer Ryuk. -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>2.0.5</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Align JNA on the version required by Testcontainers 1.21.4 to satisfy the upper-bound dependency check. -->
      <dependency>
        <groupId>net.java.dev.jna</groupId>
        <artifactId>jna</artifactId>
        <version>5.13.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <!-- The module under test, installed as an extension by the Docker test framework -->
    <dependency>
      <groupId>org.xwiki.contrib.blog</groupId>
      <artifactId>application-blog-ui</artifactId>
      <version>${project.version}</version>
      <type>xar</type>
    </dependency>
    <!-- Defines the XWiki.DocumentSheetBinding class, through which the categories home page of a blog created by
         Blog.Management is displayed with Blog.CategoriesSheet. Every XWiki distribution has it, but not the minimal
         instance of the tests, where the binding of such a page would be lost. -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-sheet-ui</artifactId>
      <version>${platform.version}</version>
      <type>xar</type>
    </dependency>
    <!-- Test dependencies -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-test-docker</artifactId>
      <version>${platform.version}</version>
      <scope>test</scope>
      <exclusions>
        <!-- Only used by webdrivermanager's Docker mode, which the Docker test framework doesn't use. Excluded since
             its version (3.2.13) conflicts with the one required by the Testcontainers version overridden above. -->
        <exclusion>
          <groupId>com.github.docker-java</groupId>
          <artifactId>docker-java</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.github.docker-java</groupId>
          <artifactId>docker-java-transport-httpclient5</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.xwiki.contrib.blog</groupId>
      <artifactId>application-blog-test-pageobjects</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <testSourceDirectory>src/test/it</testSourceDirectory>
    <plugins>
      <!-- We need to explicitly include the failsafe plugin since it's not part of the default maven lifecycle -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>clover</id>
      <!-- Add the Clover JAR to the WAR so that it's available at runtime when XWiki executes.
           It's needed because instrumented jars in the WAR will call Clover APIs at runtime when they execute. -->
      <dependencies>
        <dependency>
          <groupId>org.openclover</groupId>
          <artifactId>clover</artifactId>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <systemProperties combine.children="append">
                <!-- Tell the Docker-based test to activate the Clover profile so that the Clover JAR is added to
                     WEB-INF/lib -->
                <property>
                  <name>xwiki.test.ui.profiles</name>
                  <value>clover</value>
                </property>
              </systemProperties>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
